# ── Intraday AI engine — server .env (copy to intraday/.env; never commit) ────
# systemd sets these via EnvironmentFile; the app also loads this file directly.

# Gateway (same box). Service creds from:
#   cd <gateway_backend> && python -m scripts.register_service \
#       --name ai_intraday --scopes market,orders,positions,funds,status
GATEWAY_BASE_URL=http://localhost:8000
GATEWAY_WS_URL=ws://localhost:8000/api/ws/ticker
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET=
# must MATCH the Gateway's JWT_SECRET (to verify tokens locally)
JWT_SECRET=

# OptionSmith's chain store (coexistence: we READ it, never run our own sweep).
# Point at the OptionSmith repo's data/chains.db on this server.
OPTIONSMITH_CHAIN_DB=/opt/gateway_system/OptionSmith/data/chains.db

# trained model for the P(win) filter (ships in the repo at state/model_full.pkl)
INTRADAY_MODEL=/opt/ai_intraday/state/model_full.pkl

# runtime state locations (own DB + JSON config)
INTRADAY_CONFIG=/opt/ai_intraday/state/intraday_config.json
INTRADAY_DB=/opt/ai_intraday/state/intraday.db

# server port
PORT=8030

# §8 coordinator in the Gateway is opt-in; enable there if running multi-strategy
# EXECUTION_COORDINATOR=1
