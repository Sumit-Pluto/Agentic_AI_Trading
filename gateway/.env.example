# ── Gateway configuration ───────────────────────────────────────────────────
# Copy to .env and fill in.  .env is git-ignored; never commit real secrets.

# SQLite location (WAL mode is enabled automatically)
DATABASE_URL=sqlite:///./gateway.db

# CORS - comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173

# Encryption key for broker credentials at rest (Fernet)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Secret used to sign app-user + service JWTs. Keep private.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# On boot, rebuild the broker session + ticker from today's cached token
# (no re-login) instead of waiting for a human to hit /api/connect. 1=on.
GATEWAY_AUTO_RECONNECT=0

# ── Shoonya (Finvasia) endpoints ─────────────────────────────────────────────
# The new OAuth API (the old QuickAuth NorenWClientTP returns 502 for everyone).
SHOONYA_API_HOST=https://api.shoonya.com/NorenWClientAPI
SHOONYA_WS_URL=wss://api.shoonya.com/NorenWSAPI/

# ── Shoonya login credentials (NOTE: prefix is SHONYA_, missing an "O") ───────
# Used by the headless Selenium + TOTP OAuth login. Login is IP-whitelisted:
# it only works from the machine whose static IP is registered in the portal
# (the Mumbai VPS). Leave blank for local structural/offline testing.
SHONYA_USER_ID=
SHONYA_PASSWORD=
SHONYA_TWO_FA=
SHONYA_VENDOR_CODE=
SHONYA_API_SECRET=

# ── Shoonya egress proxy (IP-bound auth + order fallback) ────────────────────
# Shoonya only accepts IP-bound calls (auth + orders) from a registered static
# IP. If this host's IP is refused, fall back through a proxy on a whitelisted
# IP. Empty = feature off (direct only). Comma-separate several to fail over:
#   SHOONYA_PROXY=http://user:pass@host1:port,http://user:pass@host2:port
SHOONYA_PROXY=
# off | auto | on  — auto: direct first, proxy only after an IP rejection.
SHOONYA_PROXY_MODE=auto
# auth | auth+orders | all  — which call kinds may use the proxy.
SHOONYA_PROXY_SCOPE=auth+orders

# ── Shoonya order/marketable-limit tuning (optional; sane defaults in code) ──
# Shoonya RMS blocks plain MKT for API orders; MKT is converted to a limit
# priced a few ticks through the touch.
# SHOONYA_MKT_TO_LIMIT=1
# SHOONYA_MARKETABLE_TICKS=5
# SHOONYA_MARKETABLE_BUFFER_PCT=0.3

# ── Option-chain tuning (optional) ───────────────────────────────────────────
# OPTION_CHAIN_QUOTE_CONCURRENCY=8
# OPTION_CHAIN_CACHE_TTL=4

# ── Sharekhan (optional; unused in the intraday-only deployment) ─────────────
# SHAREKHAN_API_KEY=
# SHAREKHAN_SECRET_KEY=
# SHAREKHAN_CUSTOMER_ID=
