[Unit]
Description=AI Intraday Agentic Trading (engine + cockpit)
After=network.target gw-central.service
Wants=gw-central.service

[Service]
Type=simple
WorkingDirectory=/opt/ai_intraday
EnvironmentFile=/opt/ai_intraday/intraday/.env
ExecStart=/opt/ai_intraday/venv/bin/python -m uvicorn intraday.server.app:app --host 0.0.0.0 --port 8030
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
