# Copy this file to .env and fill in YOUR values. NEVER commit .env or share
# these values with anyone (including in chats) — together they are full
# access to your trading account.
#
# Where to find them: Shoonya portal → profile → "API Key" page.
# On that page also set:  Redirect URL = anything (e.g. https://google.com)
#                         Primary IP  = the static IP of the machine that
#                                       will log in (VPS). Changeable only
#                                       once per week — register the VPS IP,
#                                       not a temporary one.

# Your client code (login user id)
SHOONYA_USERID=FA00000

# API app client id — usually your user id + "_U"
SHOONYA_CLIENT_ID=FA00000_U

# API app secret code (from the API Key page)
SHOONYA_SECRET_CODE=your-secret-code

# Used on the browser login page (and by `python -m shoonya_login` on the VPS)
SHOONYA_PASSWORD=your-login-password
# The base32 TOTP secret captured when you enabled 2FA (not a 6-digit code)
SHOONYA_TOTP_SECRET=ABCDEFGHIJKLMNOP

# The Primary IP you registered in the portal (optional but recommended:
# shoonya_login warns you BEFORE login if the IP Shoonya sees no longer matches).
SHOONYA_REGISTERED_IP=203.0.113.42

# ── Optional: SSH tunnel to a static-IP machine ──────────────────────────
# If this machine's own IP is dynamic (hotspot), route broker traffic
# through any always-on machine with a static IP:
#   1. ./tunnel.sh user@that-machine     (keeps a SOCKS proxy on :1080)
#   2. register THAT machine's IP as Primary IP in the portal
#   3. uncomment:
# SHOONYA_PROXY=socks5h://127.0.0.1:1080

# ── global macro tape (Twelve Data) ──────────────────────────────────────
# The news "market tape" (US indices, US10Y, DXY, crude, gold, USD/INR, index
# futures) is GLOBAL data Shoonya/NSE does not provide. yfinance was removed;
# these now come from Twelve Data. Without a key every tape chip degrades to
# n/a (the rest of the app is unaffected). Free tier at twelvedata.com.
TWELVEDATA_KEY=

# ── news module (optional keys; RSS works without any) ──
INDIANAPI_KEY=            # indianapi.in stock API (500 req/mo — budget-guarded)
ALPHAVANTAGE_KEY=         # earnings/IPO calendar
RAPIDAPI_KEY=             # economic-calendar9 on RapidAPI (10 req/mo — weekly cache)

# ── LLM assistant (RunPod Qwen3.5-9B, OpenAI-compatible) ──────────────────
# Fill these after the endpoint is deployed (see docs/RUNPOD_TEAM_DEPLOYMENT.md).
# Until set, the assistant reports "endpoint not configured" and the MacroLLM
# leaf simply stays unavailable — nothing else is affected.
LLM_BASE_URL=            # e.g. https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1
LLM_API_KEY=            # restricted RunPod API key
LLM_MODEL=Qwen/Qwen3.5-9B

# ── performance tuning (optional) ─────────────────────────────────────────
# Concurrent in-flight Shoonya quote fetches for the option chain + candle
# prefetch (replaces the old ~34-serial-calls-per-symbol path). Raise for
# speed, lower if Shoonya rate-limits. Default 6.
CHAIN_FETCH_WORKERS=6
# Swing / OI scanner cadence (seconds) and the macro LLM refresh interval.
SWING_SCAN_SECONDS=300
OI_SCAN_SECONDS=180
MACRO_LLM_SECONDS=900
# Agent-PRIMARY signals (the tree fires without an indicator trigger).
# Paper-only by default; AGENTS_PRIMARY_LIVE=1 only after the strategy=agents
# scorecard proves itself. AGENT_SCANNER=0 disables the background sweep.
AGENT_SCANNER=1
AGENTS_SCAN_SECONDS=180
AGENTS_MIN_SCORE=70
AGENTS_MARGIN=10
AGENTS_COOLDOWN_MIN=45
AGENTS_MAX_PER_SWEEP=5
AGENTS_AUTOTRADE=1
AGENTS_PRIMARY_LIVE=0
