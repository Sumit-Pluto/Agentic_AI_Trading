# credentials & session state — never commit
.env
.session_token

# gateway runtime artifacts (broker session tokens, sqlite db, logs)
gateway/.env
gateway/*.db
gateway/*.db-wal
gateway/*.db-shm
gateway/**/token_store*.json
gateway/venv/

# intraday engine runtime state (journal db, caches, logs)
intraday/*.db
intraday/*.db-wal
intraday/*.db-shm
intraday/state/
intraday/logs/

# daily scrip master downloads (repo-root only — must NOT match intraday/data/ source)
/data/

# python
.venv/
__pycache__/
*.pyc

# frontend
frontend/node_modules/
frontend/dist/

# generated runtime state / caches (training samples, bhavcopy, oi/iv stores, api caches)


# macOS
.DS_Store

# non-code artifacts — code repo only (no research papers, datasets, model weights, build binaries)
*.pdf
*.doc
*.docx
*.so
*.pkl
*.joblib
backtest_result.json
paper_trades.jsonl
weights_3stocks.json
state/
